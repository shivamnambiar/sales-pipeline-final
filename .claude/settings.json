{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "grounded",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(terraform fmt *)",
      "Bash(terraform validate *)",
      "Bash(terraform -chdir=terraform fmt *)",
      "Bash(terraform -chdir=terraform validate *)",
      "Bash(terraform -chdir=terraform/platform-stack fmt *)",
      "Bash(terraform -chdir=terraform/platform-stack validate *)",
      "Bash(terraform init -backend=false)",
      "Bash(terraform init -backend=false -upgrade)",
      "Bash(terraform -chdir=terraform init -backend=false)",
      "Bash(terraform -chdir=terraform init -backend=false -upgrade)",
      "Bash(terraform -chdir=terraform/platform-stack init -backend=false)",
      "Bash(terraform -chdir=terraform/platform-stack init -backend=false -upgrade)",
      "Bash(terraform version)",
      "Bash(kustomize build *)",
      "Bash(kustomize version)",
      "Bash(kubeconform *)",
      "Bash(bash scripts/validate-manifests.sh *)",
      "Bash(python smoke_test.py)",
      "Bash(python test_processing.py)",
      "Bash(python integration_test.py)",
      "Bash(python3 smoke_test.py)",
      "Bash(python3 test_processing.py)",
      "Bash(python3 integration_test.py)",
      "Bash(jq *)",
      "Bash(shellcheck *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "ask": [
      "Bash(terraform plan *)",
      "Bash(python3 -c *)",
      "Bash(python3 -m *)",
      "Bash(python -c *)",
      "Bash(python -m *)",
      "Bash(perl -e *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(npx *)",
      "Bash(node *)"
    ],
    "deny": [
      "PowerShell",
      "Cd",
      "mcp__ide__executeCode",
      "Monitor",
      "NotebookEdit",
      "Bash(terraform apply *)",
      "Bash(terraform * apply *)",
      "Bash(terraform destroy *)",
      "Bash(terraform * destroy *)",
      "Bash(terraform import *)",
      "Bash(terraform * import *)",
      "Bash(terraform state *)",
      "Bash(terraform * state *)",
      "Bash(terraform taint *)",
      "Bash(terraform untaint *)",
      "Bash(terraform force-unlock *)",
      "Bash(terraform workspace *)",
      "Bash(terraform init -migrate-state *)",
      "Bash(terraform * init -migrate-state *)",
      "Bash(terraform login *)",
      "Bash(terragrunt *)",
      "Bash(aws *)",
      "Bash(aws-vault *)",
      "Bash(eksctl *)",
      "Bash(sam *)",
      "Bash(cdk *)",
      "Bash(kubectl *)",
      "Bash(helm *)",
      "Bash(kustomize *--enable-exec*)",
      "Bash(kustomize *--enable-alpha-plugins*)",
      "Bash(kustomize *--enable-helm*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(git push *)",
      "Bash(powershell *)",
      "Bash(powershell.exe *)",
      "Bash(pwsh *)",
      "Bash(cmd *)",
      "Bash(cmd.exe *)",
      "Bash(bash -c *)",
      "Bash(sh -c *)",
      "Bash(env *)",
      "Bash(eval *)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.terraformrc)",
      "Edit(~/terraform.rc)",
      "Edit(~/.terraform.d/**)",
      "Edit(**/.terraformrc)",
      "Edit(**/terraform.rc)",
      "Edit(CLAUDE.local.md)",
      "Edit(**/CLAUDE.local.md)",
      "Edit(k8s-audit.txt)",
      "Edit(audit-fixes.txt)",
      "Edit(.claude/**)",
      "Edit(scripts/validate-manifests.sh)",
      "Edit(worker/test_processing.py)",
      "Edit(worker/integration_test.py)",
      "Edit(api/smoke_test.py)",
      "Edit(**/*.tfvars)",
      "Edit(**/*.tfvars.json)",
      "Edit(.mcp.json)",
      "Edit(~/.claude.json)",
      "Edit(~/.claude/CLAUDE.md)",
      "Edit(~/.claude/rules/**)",
      "Edit(~/.claude/agents/**)",
      "Edit(~/.claude/skills/**)",
      "Edit(~/.claude/output-styles/**)",
      "Edit(~/.claude/hooks/**)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/*.tfplan)",
      "Read(**/tfplan)",
      "Read(**/crash.log)",
      "Read(**/plan.txt)",
      "Edit(~/.claude/settings.json)",
      "Edit(CLAUDE.md)",
      "Edit(**/CLAUDE.md)",
      "Edit(docs/DESIGN.md)",
      "Edit(**/*.md)"
    ]
  }
}