{
  "target": "http://api.sales-pipeline.svc.cluster.local:8000",
  "workers": 2,
  "tick_ms": 5,
  "max_inflight": 2000,
  "connect_timeout_s": 5.0,
  "read_timeout_s": 30.0,
  "bodies_per_variant": 8,
  "ndjson_path": "/data/gen-requests.ndjson",
  "ndjson_sample": 1,
  "resolve_once": true,
  "start_grace_s": 5.0,
  "deadline_s": 2700,
  "on_complete": "idle",
  "cpu_limit_m": 2000,
  "stages": [
    {"name": "base", "kind": "idle", "duration_s": 120},

    {"name": "A-200", "kind": "get", "path": "/__loadgen_ping", "rate": 200, "duration_s": 45,
     "stop_rule": {"accept_ratio_min": 0.95, "cpu_frac_max": 0.85, "window_s": 20, "on_trip": "record"}},
    {"name": "A-gap1", "kind": "idle", "duration_s": 130},
    {"name": "A-500", "kind": "get", "path": "/__loadgen_ping", "rate": 500, "duration_s": 45,
     "stop_rule": {"accept_ratio_min": 0.95, "cpu_frac_max": 0.85, "window_s": 20, "on_trip": "record"}},
    {"name": "A-gap2", "kind": "idle", "duration_s": 130},
    {"name": "A-1000", "kind": "get", "path": "/__loadgen_ping", "rate": 1000, "duration_s": 45,
     "stop_rule": {"accept_ratio_min": 0.95, "cpu_frac_max": 0.85, "window_s": 20, "on_trip": "record"}},
    {"name": "A-gap3", "kind": "idle", "duration_s": 130},
    {"name": "A-2000", "kind": "get", "path": "/__loadgen_ping", "rate": 2000, "duration_s": 45,
     "stop_rule": {"accept_ratio_min": 0.95, "cpu_frac_max": 0.85, "window_s": 20, "on_trip": "record"}},
    {"name": "A-gap4", "kind": "idle", "duration_s": 130},
    {"name": "A-4000", "kind": "get", "path": "/__loadgen_ping", "rate": 4000, "duration_s": 25,
     "stop_rule": {"accept_ratio_min": 0.95, "cpu_frac_max": 0.85, "window_s": 15, "on_trip": "record"}},
    {"name": "A-settle", "kind": "idle", "duration_s": 180},

    {"name": "P-5", "kind": "jobs", "path": "/jobs", "rate": 5, "duration_s": 120,
     "mix": [{"n": 1000, "weight": 1.0, "reject_frac": 0.02}],
     "stop_rule": {"accept_ratio_min": 0.95, "cpu_frac_max": 0.85, "window_s": 30, "on_trip": "record"}},
    {"name": "P-gap1", "kind": "idle", "duration_s": 60},
    {"name": "P-25", "kind": "jobs", "path": "/jobs", "rate": 25, "duration_s": 120,
     "mix": [{"n": 1000, "weight": 1.0, "reject_frac": 0.02}],
     "stop_rule": {"accept_ratio_min": 0.95, "cpu_frac_max": 0.85, "window_s": 30, "on_trip": "record"}},
    {"name": "P-gap2", "kind": "idle", "duration_s": 60},
    {"name": "P-50", "kind": "jobs", "path": "/jobs", "rate": 50, "duration_s": 120,
     "mix": [{"n": 1000, "weight": 1.0, "reject_frac": 0.02}],
     "stop_rule": {"accept_ratio_min": 0.95, "cpu_frac_max": 0.85, "window_s": 30, "on_trip": "record"}},
    {"name": "P-gap3", "kind": "idle", "duration_s": 60},
    {"name": "P-100", "kind": "jobs", "path": "/jobs", "rate": 100, "duration_s": 120,
     "mix": [{"n": 1000, "weight": 1.0, "reject_frac": 0.02}],
     "stop_rule": {"accept_ratio_min": 0.95, "cpu_frac_max": 0.85, "window_s": 30, "on_trip": "record"}},

    {"name": "drain", "kind": "idle", "duration_s": 600}
  ]
}
